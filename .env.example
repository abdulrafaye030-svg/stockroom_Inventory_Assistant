# Copy this file to .env and fill in your own values. .env is ignored by git.
# On Vercel, add the same names under Settings -> Environment Variables instead.

# The admin account (username is not case-sensitive). Optional if STOCKROOM_SECRET is set
# and people register their own accounts.
STOCKROOM_USERNAME=
STOCKROOM_PASSWORD=

# Long random string used to sign session cookies. Generate one with:
#   py -c "import secrets; print(secrets.token_hex(32))"
STOCKROOM_SECRET=

# Let people create their own accounts from the sign-in page (true or false).
# Anyone who registers can see products, customer balances and the assistant.
STOCKROOM_ALLOW_SIGNUP=true
